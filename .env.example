# Databricks Connect Configuration
# Copy this file to .env and fill in your actual values

# Databricks workspace host (e.g., https://adb-1234567890.azuredatabricks.net)
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net/

# Personal Access Token or OAuth token -- NEVER commit a real value here
DATABRICKS_TOKEN=dapi<REDACTED_NEVER_COMMIT_A_REAL_TOKEN>

# Cluster ID (e.g., 1234-567890-abcdef)
DATABRICKS_CLUSTER_ID=<your-cluster-id>

# Warehouse ID (alternative to cluster for SQL operations)
# DATABRICKS_WAREHOUSE_ID=<your-warehouse-id>

# Optional: HTTP path for warehouse
# HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Catalog and schema (for Unity Catalog)
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=medallion_orders

# Service Principal Auth (alternative to PAT)
# DATABRICKS_CLIENT_ID=<service-principal-client-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
